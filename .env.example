# Everything has a default: the game runs without a .env file.

# ───────── Game server (apps/server) ─────────
PORT=3210
# Allowed web origins, comma separated. "*" is fine for local play; set your real domain when hosting publicly.
CORS_ORIGIN=*
# A disconnected player holds up their turn / opening shot for at most this long, then the server plays for them.
DISCONNECT_GRACE_SEC=60
# A disconnected player keeps their lobby seat this long.
LOBBY_GRACE_SEC=30
# Rooms with nobody connected are deleted after this many minutes.
ROOM_IDLE_MIN=15
# Per-socket flood protection: at most RATE_LIMIT events per RATE_LIMIT_WINDOW_MS.
RATE_LIMIT=40
RATE_LIMIT_WINDOW_MS=5000
# Folder of the built web app that the server also serves (default: apps/web/.output/public, made by `npm run build:web`).
# WEB_DIR=

# ───────── Web app build (apps/web) ─────────
# Normally leave empty: the built app talks to the server it was loaded from. Set a full URL only if the
# web app is hosted somewhere different from the game server.
NUXT_PUBLIC_SERVER_URL=

# ───────── docker-compose.prod.yml ─────────
DOMAIN=localhost
